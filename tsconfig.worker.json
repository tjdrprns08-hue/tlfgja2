{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "composite": true,
    "outDir": "dist/worker",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "src/index.ts",
    "src/api_handlers.ts"
  ]
}
